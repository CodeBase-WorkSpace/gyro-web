# Public gyro-web template. Keep disabled until ADR 0006 is revisited.
name: Frontend contract

on:
  pull_request:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  contract:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "22"
      - run: corepack enable
      - run: pnpm install --frozen-lockfile
      - run: pnpm run contract:check
      - run: pnpm run typecheck
      - run: pnpm run test
      - run: pnpm run build
