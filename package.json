{
  "name": "gyro-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "dev": "next dev -p ${PORT:-3002}",
    "lint": "eslint .",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "contract:check": "node scripts/check-api-contract.mjs",
    "icons:pwa": "./scripts/create-pwa-icons.sh",
    "images:optimize": "node scripts/optimize-images.mjs",
    "bundle:measure": "node scripts/measure-bundle.mjs",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/**/*.test.js",
    "test:watch": "tsc -p tsconfig.test.json --watch --preserveWatchOutput"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.14"
    }
  },
  "dependencies": {
    "@base-ui/react": "1.4.1",
    "@hookform/resolvers": "5.2.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jose": "6.2.3",
    "lucide-react": "1.14.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.75.0",
    "recharts": "3.8.0",
    "shadcn": "4.7.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.2.6",
    "@tailwindcss/postcss": "4.2.4",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.14",
    "sharp": "0.35.3",
    "tailwindcss": "4.2.4",
    "typescript": "6.0.3"
  }
}
