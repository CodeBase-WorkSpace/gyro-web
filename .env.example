# Both API origins must include the versioned base path.
API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

NEXT_PUBLIC_MARKETING_BASE_URL=http://localhost:3002
NEXT_PUBLIC_APP_BASE_URL=http://app.localhost:3002

# The API public key is optional locally. Without it, the proxy validates sessions through the API.
JWT_PUBLIC_KEY=
JWT_ISSUER=gyro-api-contributor-local
JWT_AUDIENCE=gyro-contributor-local

PREMIUM_GATING_DISABLED=false
FRONTEND_TELEGRAM_ENABLED=false
FRONTEND_NOTIFICATION_PERMISSION_PROMPT_ENABLED=true
FRONTEND_NUTRITION_COACH_ENABLED=true

GYRO_DEBUG_LOGS=true
NEXT_PUBLIC_GYRO_DEBUG_LOGS=true

# Optional public integrations. Leave blank for local development.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
